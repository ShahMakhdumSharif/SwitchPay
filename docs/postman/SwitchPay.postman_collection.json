{
  "info": {
    "name": "SwitchPay",
    "description": "SwitchPay API collection. One folder per module plus a Smoke folder.\nRun 'Auth > Login' first; it saves the JWT into {{token}} for every other request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Smoke",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('app is UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/actuator/health"
          }
        },
        {
          "name": "OpenAPI docs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('title is SwitchPay API', () => pm.expect(pm.response.json().info.title).to.eql('SwitchPay API'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/v3/api-docs"
          }
        }
      ]
    },
    {
      "name": "Auth (F8)",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    { "name": "Accounts (F3)", "item": [] },
    { "name": "Transactions (F2, F5)", "item": [] },
    { "name": "Channels (F1)", "item": [] },
    { "name": "Merchants and Checkout (F4)", "item": [] },
    { "name": "Settlements (F4)", "item": [] },
    { "name": "Ledger (F6)", "item": [] },
    { "name": "Adjustments (F7)", "item": [] },
    { "name": "Ops Monitoring (F9)", "item": [] }
  ]
}
